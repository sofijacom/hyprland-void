# Template file for 'hyprland'

pkgname=hyprland
version=0.56.1
revision=1
build_style=cmake
configure_args+=" --no-warn-unused-cli"
configure_args+=" -DCMAKE_BUILD_TYPE:STRING=Release"
configure_args+=" -DCMAKE_INSTALL_PREFIX:PATH=/usr"
configure_args+=" -DNO_SYSTEMD:BOOL=true"
configure_args+=" -DCMAKE_CXX_STANDARD=23"

othermakedepends="
  cmake
  cpio
  gcc
  glslang
  hyprwayland-scanner
  hyprwire
  jq
  make
  meson
  ninja
  pkgconf
  wayland-devel
  python3
  xxd
  xorgproto
  git
"

hostmakedepends=$othermakedepends

makedepends="
  aquamarine
  cairo-devel
  glaze
  hwids
  hyprcursor
  hyprgraphics
  hyprlang
  hyprutils
  hyprwire
  libdisplay-info-devel
  libdrm-devel
  libgbm-devel
  libglvnd-devel
  libinput-devel
  libliftoff-devel
  libseat-devel
  libxcb-devel
  libXcursor-devel
  libxkbcommon-devel
  muparser-devel
  pango-devel
  re2-devel
  tomlplusplus
  wayland-devel
  wayland-protocols
  xcb-util-errors-devel
  xcb-util-renderutil-devel
  xcb-util-wm-devel
  xorg-server-xwayland
  hyprland-protocols
  glslang-devel
  lcms2-devel
  lua55-devel
  SPIRV-Tools-devel
  libei-devel
  readline-devel
"
short_desc="Dynamic tiling Wayland compositor that doesn't sacrifice on its looks"
maintainer="Sofiya <sofiya@v.org>"
license="BSD-3-Clause"
homepage="https://hyprland.org/"
changelog="https://github.com/hyprwm/Hyprland/releases"
distfiles="https://github.com/hyprwm/Hyprland/releases/download/v${version}/source-v${version}.tar.gz"
checksum=c5b26eb377360358d01839a1de43fdc004a33e56d6a5d442fdad69b9f3a10549
make_check=no # cant run in sandbox

if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
  configure_args+=" -DCMAKE_CXX_FLAGS=\"-lexecinfo\""
  makedepends+=" libexecinfo-devel"
  depends+=" libexecinfo"
fi

do_build() {
    # Явно используем make, чтобы избежать ошибки с пустым make_cmd
    make ${makejobs} ${XBPS_VERBOSE+${make_verbose}} ${make_build_args} ${make_build_target}
}

post_install() {
  vlicense LICENSE

  vmkdir usr/include/hyprland
  vmkdir usr/include/hyprland/protocols
  vmkdir usr/share/pkgconfig

  # Пробуем сгенерировать заголовки, если папка build есть
  if [ -d build ]; then
    cmake --build ./build --config Release --target generate-protocol-headers 2>/dev/null || true
  fi

  find src -type f \( -name '*.hpp' -o -name '*.h' -o -name '*.inc' \) -print0 | cpio --quiet -0dump ${DESTDIR}/usr/include/hyprland 2>/dev/null || true
  install -Dm0644 protocols/*.h* ${DESTDIR}/usr/include/hyprland/protocols 2>/dev/null || true
  install -Dm0644 build/hyprland.pc ${DESTDIR}/usr/share/pkgconfig 2>/dev/null || true
}

hyprland-devel_package() {
  depends="${sourcepkg}>=${version}_${revision} ${othermakedepends} ${makedepends}"
  short_desc="Dynamic tiling Wayland compositor - development files"
  pkg_install() {
    vmove usr/include
    vmove usr/share/pkgconfig
  }
}
