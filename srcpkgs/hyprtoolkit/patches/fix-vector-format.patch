+// std::format cannot format a std::vector; flatten it for the log calls below.
+static std::string joinThemeDirs(const std::vector<std::string>& themeDirs) {
+    std::string result;
+
+    for (const auto& themeDir : themeDirs) {
+        result += result.empty() ? themeDir : ", " + themeDir;
+    }
+
+    return result;
+}
