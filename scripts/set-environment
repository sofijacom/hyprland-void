#!/usr/bin/env sh

# Проверка на -musl через case — самый надёжный способ в чистом sh
case "$TARGET_ARCH" in
  *-musl)
    echo "RESULT_NAME=${TARGET_ARCH}-glibc" >> "$GITHUB_ENV"
    ;;
  *)
    echo "RESULT_NAME=${TARGET_ARCH}" >> "$GITHUB_ENV"
    ;;
esac

# Проверка на архитектуру
if [ "$TARGET_ARCH" != "x86_64" ] && [ "$TARGET_ARCH" != "x86_64-musl" ]; then
  if [ -n "${BUILD_ARGS+x}" ]; then
    echo "BUILD_ARGS=${BUILD_ARGS} -a ${TARGET_ARCH}" >> "$GITHUB_ENV"
  else
    echo "BUILD_ARGS=-a ${TARGET_ARCH}" >> "$GITHUB_ENV"
  fi
fi
